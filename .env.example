# MyBlog Docker 部署环境变量模板
# 用法：cp .env.example .env 然后修改以下各项（务必修改为随机强值）

# MySQL root 密码（请修改！仅模式 A 的 compose 自带 MySQL 使用）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# JWT 签名密钥（请修改！生产环境使用弱密钥任何人都能伪造登录态）
# 生成示例：openssl rand -hex 32
BLOG_JWT_SECRET=change-me-random-secret

# 敏感字段静态加密密钥（评论邮箱/IP、管理员邮箱在数据库中 AES-256-GCM 加密存储）
# 可选：留空则首次启动自动生成并持久化到容器 /app/data/blog.crypto.key（随 server-data 卷保存）
# 建议显式设置并妥善备份——密钥丢失后已加密数据无法解密
# 生成示例：openssl rand -hex 32
# BLOG_CRYPTO_KEY=

# 端口绑定地址（安全默认：仅宿主机本机可访问，外网不可达）
# 局域网访问改为内网 IP，如 BLOG_BIND=192.168.1.10；切勿设 0.0.0.0（等于向公网开放）
# BLOG_BIND=127.0.0.1

# 后端连接 MySQL 的 DSN（必填）
# 模式 A（compose 自带 MySQL）用下面这行默认值即可（密码与 MYSQL_ROOT_PASSWORD 保持一致）：
BLOG_MYSQL_DSN=root:change-me-strong-password@tcp(mysql:3306)/myblog?charset=utf8mb4&parseTime=True&loc=Local
# 模式 B（复用服务器已有 MySQL）：注释掉上面一行，改成你的账号/主机，例如：
# BLOG_MYSQL_DSN=blog:S3cret@tcp(127.0.0.1:3306)/myblog?charset=utf8mb4&parseTime=True&loc=Local
# 主机在本机时容器内不要用 localhost，用 host.docker.internal 或宿主内网 IP（见部署文档）。

# 定时发布扫描间隔（秒）：到期定时文章由后端自动发布，启动时也会补跑一次
# 可选：默认 30，最小 5；一般无需修改
# BLOG_SCHEDULE_INTERVAL_SECONDS=30

# 备份目录：后台「系统→备份」产出的数据库/全站备份存放位置（不对外提供访问）
# 可选：默认 backups；容器部署请确保该目录挂卷持久化
# BLOG_BACKUP_DIR=backups

# ===== 防护（反爬 / 恶意请求拦截 / 自动封禁）=====
# 全局每 IP 每分钟请求数上限（前台 + 管理端 + RSS/上传全部生效），0=关闭
# 超限返回 HTTP 429 + Retry-After 并计 1 点；默认 240
# BLOG_RATE_LIMIT_PER_MIN=240

# 恶意请求拦截（WAF）模式：block=拦截+计点（默认）/ log=只记录事件不拦截（上线前建议先观察）/ off=关闭
# 拦截范围：攻击工具 UA（sqlmap/nikto/nuclei 等）、CMS/隐藏文件探测路径（.php/.env/.git/wp-* 等）、
#           查询串注入与目录穿越特征（关键词搜索接口豁免注入特征检查，目录穿越仍拦截）
# BLOG_WAF_MODE=block

# 自动封禁：滑动窗口内违规计点（WAF 命中/限流超限/登录锁定后仍尝试）达到阈值即封禁该 IP，0=关闭
# 封禁写入数据库 banned_ips 表，重启不失效；默认阈值 10
# BLOG_BAN_THRESHOLD=10

# 违规计点滑动窗口（分钟），默认 10
# BLOG_BAN_WINDOW_MINUTES=10

# 自动封禁时长（分钟），默认 30
# BLOG_BAN_DURATION_MINUTES=30

# 防护白名单（逗号分隔 IP/CIDR）：完全跳过封禁/WAF/限流
# 建议加入自己常用的出口 IP 与监控探针地址；默认仅回环
# BLOG_BAN_WHITELIST=127.0.0.1,::1
